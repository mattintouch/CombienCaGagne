# ── Combien Ça Gagne — Variables d'environnement ──

# URL de l'API newsletter (Kessel Point Média ou autre)
# Le formulaire POST les données { prenom, email } en JSON
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# URL du site en production (utilisée pour les OG tags et le sitemap)
NEXT_PUBLIC_SITE_URL=https://combiencagagne.fr

# Désactiver les embeds Spotify en dev (true/false)
NEXT_PUBLIC_SPOTIFY_EMBED_DISABLED=false
